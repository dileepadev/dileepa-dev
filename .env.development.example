# Development configuration for dileepa.dev (v2.0.0, Next.js).
#
#   cp .env.development.example .env.development
#
# This file is complete on its own. `next dev` loads `.env.development` and
# nothing else — there is no shared base file and no `.env.local` override, so
# the value you read here is the value in effect. Real environment variables
# still win, which is how you override one for a single command:
#
#   BLOG_CONTENT_REF=b09cb0f13e006f3d60bbdace932025226b5de2a6 npm run dev
#
# Its production counterpart is .env.production.example. The two overlap on
# purpose: duplication is the price of never having to work out which file won.
#
# Real .env.* files are gitignored. Only these *.example templates are
# committed, and they must never carry a real value.

# --- API -----------------------------------------------------------------
# The FastAPI backend. Ships to the browser, so it must not hold a secret.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Site ----------------------------------------------------------------
# Used to compose canonical URLs, the sitemap and RSS. Must match the origin
# the app is actually served from, or every canonical tag points elsewhere.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Blog content --------------------------------------------------------
# Post bodies are read from Git at build time. Metadata comes from the API;
# the two are joined by slug.
BLOG_CONTENT_REPO=dileepadev/blog-dileepa-dev

# A commit SHA in production; `main` is acceptable here, where a build is cheap
# and being one commit behind is a nuisance rather than a bug. It is ignored
# entirely while BLOG_CONTENT_LOCAL_PATH is set.
BLOG_CONTENT_REF=main

# Where the posts live in that repo. Posts are grouped by year and month:
# posts/<year>/<month>/<slug>.md
BLOG_CONTENT_POSTS_DIR=posts
# The same repository and ref, exposed to the browser.
#
# `MarkdownImage` runs on the client and resolves a relative image path in a
# post body against `raw.githubusercontent.com`, so it cannot read the two
# server-only values above. Both default to the same thing they do, and no
# post currently uses a relative image path — every image is a Cloudinary URL —
# so this only matters if one ever does.
#
# **Keep them in step with the pair above.** Pinning BLOG_CONTENT_REF to a SHA
# without pinning this one would read post text from the SHA and post images
# from `main`.
# NEXT_PUBLIC_BLOG_CONTENT_REPO=dileepadev/blog-dileepa-dev
# NEXT_PUBLIC_BLOG_CONTENT_REF=main


# Read posts from a local checkout instead of GitHub, so this works offline
# and without hitting the anonymous rate limit. Leave unset anywhere but your
# own machine.
BLOG_CONTENT_LOCAL_PATH=../blog-dileepa-dev

# Optional locally, required in CI. The blog repo is public so anonymous reads
# work, but the anonymous rate limit is low enough that a build fetching 19
# files can hit it — and that failure looks like a content bug.
# GITHUB_TOKEN=

# --- Analytics (public by nature) ----------------------------------------
# Both are no-ops unless NODE_ENV is production, so they can be left set.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_MICROSOFT_CLARITY_PROJECT_ID=

# --- YouTube (optional) --------------------------------------------------
# If unset, video duration is resolved from public watch page metadata.
# Set this to use Google's YouTube Data API v3 directly.
YOUTUBE_API_KEY=
