# Production configuration for dileepa.dev (v2.0.0, Next.js).
#
#   cp .env.production.example .env.production
#   npm run build && npm start
#
# **The real deployment does not read this file.** Vercel holds its own
# configuration, set per environment in the project settings. Keep the
# authoritative copy of anything sensitive in a password manager, and remember
# that changing one needs a redeploy to take effect.
#
# This file is for running production mode on your own machine — rehearsing a
# release, reproducing a production-only bug. It is complete on its own:
# `next build` and `next start` load `.env.production` and nothing else.
#
# Real .env.* files are gitignored. Only these *.example templates are
# committed, and they must never carry a real value.

# --- API -----------------------------------------------------------------
# Ships to the browser, so it must not hold a secret. The origin named here
# must also appear in the API's CORS_ORIGINS allowlist.
NEXT_PUBLIC_API_URL=https://api.dileepa.dev

# --- Site ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://dileepa.dev

# --- Blog content --------------------------------------------------------
BLOG_CONTENT_REPO=dileepadev/blog-dileepa-dev

# PIN THIS. A commit SHA on the blog repo's `main`, never `main` itself. An
# unpinned ref makes a build's output depend on when it ran, so a rebuild is not
# reproducible and an in-progress edit can ship by accident. Bump it
# deliberately when publishing — that is step 4 of content-pipeline.md §8.
#
# A SHA rather than a tag: the blog repo stopped cutting release tags at
# v2.0.0, and content is not versioned.
#
# **A ref without a `posts/` directory is the failure this variable causes.**
# Post metadata comes from the API, so `/blog` lists every post while every post
# page 404s — which is exactly what pointing at the pre-v2.0.0 blog tree did.
# `lib/content.ts` now fails the build on an empty post set rather than
# prerendering eighteen 404 pages and reporting success.
BLOG_CONTENT_REF=b09cb0f13e006f3d60bbdace932025226b5de2a6

BLOG_CONTENT_POSTS_DIR=posts
# The same repository and ref, exposed to the browser.
#
# `MarkdownImage` runs on the client and resolves a relative image path in a
# post body against `raw.githubusercontent.com`, so it cannot read the two
# server-only values above. Both default to the same thing they do, and no
# post currently uses a relative image path — every image is a Cloudinary URL —
# so this only matters if one ever does.
#
# **Keep them in step with the pair above.** Pinning BLOG_CONTENT_REF to a SHA
# without pinning this one would read post text from the SHA and post images
# from `main`.
# NEXT_PUBLIC_BLOG_CONTENT_REPO=dileepadev/blog-dileepa-dev
# NEXT_PUBLIC_BLOG_CONTENT_REF=b09cb0f13e006f3d60bbdace932025226b5de2a6


# BLOG_CONTENT_LOCAL_PATH is deliberately absent. A production build reads the
# pinned ref from GitHub; a local checkout would make the output depend on
# whatever happened to be on the build machine's disk.

# Required in CI. The blog repo is public so anonymous reads work, but the
# anonymous rate limit is low enough that a build fetching 19 files can hit it,
# and that failure looks like a content bug.
GITHUB_TOKEN=

# --- Analytics (public by nature) ----------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_MICROSOFT_CLARITY_PROJECT_ID=
